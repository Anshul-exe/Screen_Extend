#!/bin/sh
# screenextend - control the Deskflow screen-extend link to laptop "ARCH"
# Added 2026-09-04.  REVERT: rm ~/.local/bin/screenextend
LAPTOP="mirr@192.168.0.117"
LOG="$HOME/.cache/deskflow-server.log"

# The laptop's XAUTHORITY path is randomised at each login, so discover it.
remote_x_env() {
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$LAPTOP" \
      'p=$(pgrep -u mirr -f "i3-with-shmlog|^i3$" | head -1); \
       xa=$(tr "\0" "\n" < /proc/$p/environ 2>/dev/null | grep ^XAUTHORITY | cut -d= -f2); \
       echo "DISPLAY=:0 XAUTHORITY=$xa"'
}

# Same problem locally: a shell (e.g. an old tmux pane) can carry a stale
# XAUTHORITY from a previous login, and deskflow-core then aborts with
# "Invalid MIT-MAGIC-COOKIE-1 key". Take the X env from the running i3 instead.
local_x_env() {
    p=$(pgrep -u "$(id -u)" -x i3 | head -1)
    [ -n "$p" ] || return
    tr '\0' '\n' < /proc/$p/environ 2>/dev/null | grep -E '^(DISPLAY|XAUTHORITY)='
}

case "$1" in
  start)
    if pgrep -x deskflow-core >/dev/null 2>&1; then
      echo "server: already running"
    else
      for kv in $(local_x_env); do export "$kv"; done
      nohup deskflow-core server >"$LOG" 2>&1 &
      sleep 1
      if kill -0 $! 2>/dev/null; then echo "server: started"
      else echo "server: FAILED to start -- see $LOG"; tail -3 "$LOG"; exit 1; fi
    fi
    env_str=$(remote_x_env)
    ssh -o BatchMode=yes "$LAPTOP" \
      "pgrep -x deskflow-core >/dev/null 2>&1 && echo 'client: already running' || \
       { export $env_str; setsid nohup deskflow-core client >~/deskflow-client.log 2>&1 </dev/null & sleep 1; echo 'client: started'; }"
    ;;
  stop)
    pkill -x deskflow-core 2>/dev/null && echo "server: stopped" || echo "server: not running"
    ssh -o BatchMode=yes "$LAPTOP" 'pkill -x deskflow-core 2>/dev/null && echo "client: stopped" || echo "client: not running"'
    ;;
  status)
    echo "server (Lenuks): $(pgrep -x deskflow-core >/dev/null 2>&1 && echo RUNNING || echo stopped)"
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$LAPTOP" \
      'echo "client (ARCH):   $(pgrep -x deskflow-core >/dev/null 2>&1 && echo RUNNING || echo stopped)"' \
      2>/dev/null || echo "client (ARCH):   unreachable"
    # Both processes can be RUNNING while the link is dead: if the server stalls
    # past the heartbeat the client drops, reconnects, and the server may never
    # accept the new connection -- TCP shows ESTABLISHED but no session exists.
    # So ask the client what its last connection event actually was.
    last=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$LAPTOP" \
      'grep -hoE "connected to server|connecting to|server is dead|failed to connect" \
         ~/deskflow-client.log 2>/dev/null | tail -1' 2>/dev/null)
    case "$last" in
      "connected to server") echo "link:            CONNECTED" ;;
      "")                    echo "link:            unknown (no client log yet)" ;;
      *)                     echo "link:            NOT CONNECTED (client: $last) -- run: screenextend stop && screenextend start" ;;
    esac
    echo "--- last link events ---"
    grep -E "accepted client connection|connected|disconnected|switch from" "$LOG" 2>/dev/null | tail -5
    ;;
  unstick)
    # Release every modifier on BOTH machines. Use when a screen gets stuck
    # behaving as if Ctrl/Alt/Shift is held down -- a known failure mode of
    # X11 keyboard sharing when a modifier is held across a screen switch.
    #
    # Release by KEYCODE, not keysym: one keysym can live on several keycodes
    # (Alt_L is both 64 and 204 here). "xdotool keyup Alt_L" only releases 64,
    # so a stuck 204 -- seen 2026-11-10 on the laptop's XTEST keyboard, which is
    # what Deskflow types through -- survived the old keysym-based loop.
    # So walk every keycode in the modifier map (`xmodmap -pm`, incl. Lock).
    REL='for h in $(xmodmap -pm | grep -oE "0x[0-9a-f]+"); do xdotool keyup $(printf %d $h) 2>/dev/null; done'
    eval "$REL"
    echo "main (Lenuks): modifiers released"
    env_str=$(remote_x_env)
    ssh -o BatchMode=yes "$LAPTOP" "export $env_str; $REL; \
      echo 'laptop (ARCH):  modifiers released'"
    ;;
  log) tail -f "$LOG" ;;
  *) echo "usage: screenextend {start|stop|status|unstick|log}" ; exit 1 ;;
esac
